{
  "prop": "arena-board",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "origin": "top-left, y down, px"
  },
  "arena": {
    "center": [
      540.0,
      1010.0
    ],
    "radius": 445.0,
    "floor": "#1c162b",
    "grid": {
      "cell": 74,
      "line": "#0f061c",
      "line_width": 4,
      "lines": 16,
      "first_line_offset": "centre - cell/2 - 7*cell",
      "highlight": {
        "color": "#3c3656",
        "alpha": 0.25,
        "width": 1.2,
        "offset": 2.6
      }
    },
    "vignette": {
      "inner": {
        "color": "#ffffff",
        "alpha": 0.035,
        "center": [
          540.0,
          950.0
        ],
        "radius": 60
      },
      "mid": {
        "stop": 0.55,
        "alpha": 0.0
      },
      "edge": {
        "color": "#080312",
        "alpha": 0.55
      }
    }
  },
  "rim": {
    "calm": "#9182be",
    "fight": "#f06ec8",
    "width": 5,
    "glow_strokes": [
      {
        "width": 30,
        "alpha": 0.05
      },
      {
        "width": 20,
        "alpha": 0.08
      },
      {
        "width": 12,
        "alpha": 0.14
      }
    ],
    "slowmo_glow_multiplier": 1.5,
    "drawn": "under the balls/swords so swords can poke over it"
  },
  "title": {
    "y": 128,
    "font": "Poppins ExtraBold",
    "size": 112,
    "max_width": 860,
    "shrink_step": 2,
    "fill": "#fb7fd3",
    "outline": "#1b0930",
    "outline_width": 5,
    "shadow": {
      "dx": 0,
      "dy": 7,
      "color": "#080212",
      "alpha": 0.85
    }
  },
  "subtitle": {
    "y": 218,
    "font": "Poppins Regular",
    "size": 40,
    "color": "#efe4fb"
  },
  "status_row": {
    "y": 405,
    "left_x": 320,
    "right_x": 680,
    "font": "Poppins ExtraBold",
    "size": 40,
    "left_color": "#9bd9fb",
    "right_colors": {
      "pink": "#f472d0",
      "yellow": "#ffd650"
    }
  },
  "bottom_message": {
    "y": 1575,
    "outline": "#0a0414",
    "plain": {
      "font": "Poppins Bold",
      "size": 50,
      "max_width": 960,
      "outline_width": 4,
      "pulse": "scale 1 + 0.025*sin(2*pi*1.2*t)",
      "fade_in": 0.15
    },
    "pop": {
      "font": "Poppins ExtraBold",
      "size": 62,
      "max_width_at_1.12x": 1010,
      "outline_width": 5,
      "pop": "scale 1.12 -> 1 over 0.18 s",
      "fade_out": 0.12
    },
    "duel": {
      "font": "Poppins ExtraBold",
      "size": 62,
      "separator": "  vs  ",
      "outline_width": 5,
      "pop": "scale 1.12 -> 1 over 0.2 s"
    }
  },
  "banner": {
    "font": "Poppins Black",
    "size": 140,
    "final_duel_size": 104,
    "color": "#ffd650",
    "outline": "#14061e",
    "outline_width": 9,
    "shadow": {
      "dx": 0,
      "dy": 8,
      "color": "#000000",
      "alpha": 0.5
    },
    "slam": "scale 1.6 -> 1 over 0.16 s",
    "fade_out": 0.25,
    "durations": {
      "FIGHT!": 1.0,
      "FINAL DUEL!": 1.1
    }
  },
  "fonts": {
    "source": {
      "family": "Poppins",
      "license": "SIL Open Font License 1.1",
      "get": [
        "https://fonts.google.com/specimen/Poppins",
        "https://github.com/google/fonts/tree/main/ofl/poppins",
        "npm @fontsource/poppins@5.3.0 (woff2, converted to ttf by get_fonts.py)"
      ],
      "installer": "ball-sims/style-kit/get_fonts.py"
    },
    "used": [
      {
        "name": "Poppins ExtraBold",
        "weight": 800,
        "file": "Poppins-ExtraBold.ttf",
        "key": "xb"
      },
      {
        "name": "Poppins Black",
        "weight": 900,
        "file": "Poppins-Black.ttf",
        "key": "blk"
      },
      {
        "name": "Poppins Bold",
        "weight": 700,
        "file": "Poppins-Bold.ttf",
        "key": "b"
      },
      {
        "name": "Poppins Regular",
        "weight": 400,
        "file": "Poppins-Regular.ttf",
        "key": "r"
      }
    ]
  }
}