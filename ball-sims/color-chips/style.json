  },
  "label": {
    "offset": [
      48,
      28
    ],
    "align": "left",
    "font": "Poppins Bold",
    "size": 23,
    "size_6plus_letters": 22,
    "color": "#f0ecfa",
    "alpha_out": 0.42
  },
  "hp_bar": {
    "offset": [
      12,
      49
    ],
    "width": 132,
    "height": 7,
    "radius": 3.5,
