{
  "prop": "wildlore-blender-kit",
  "engine": {
    "blender": "4.0.2",
    "renderer": "EEVEE (Legacy)",
    "headless": "xvfb-run -a blender -b -noaudio --python <script>"
  },
  "frame": {
    "width": 1080,
    "height": 1920,
    "fps": 24,
    "units": "metres"
  },
  "look": {
    "view_transform": "AgX",
    "look": "AgX - Medium High Contrast",
    "exposure_default": 0.0,
    "taa_samples": {
      "shots": 3,
      "shot B (forest establishing)": 5,
      "stills": 64
    },
    "soft_shadows": true,
    "shadow_cube": "512 (stills 1024)",
    "shadow_cascade": "1024 (stills 2048)",
    "gtao_distance": {
      "default": 0.2,
      "macro": 0.004,
      "close-ups": 0.008
    },
    "bloom": {
      "threshold": 1.2,
      "intensity": 0.035,
      "radius": 5.0,
      "default": "off; on for highlights in close-ups"
    },
    "bokeh": {
      "blades": 7,
      "max_size_px": "60 * width / 720 (stills raise it to 140-220 * width / 1080)",
      "threshold": 4.0
    },
    "compositor": "vignette, optional fog, film grain, optional glare"
  },
  "world": {
    "forest": {
      "hdri": "babylon_forest.hdr",
      "rot_rad": 3.4,
      "strength": "0.8-0.9"
    },
    "farm": {
      "hdri": "babylon_country.hdr"
    },
    "camera_backdrop": "world_hdri(cam_strength, clamp_bg) gives the backdrop its own brightness; thumbnails give the camera its own rotated patch of the HDRI"
  },
  "palette_linear": {
    "drupelet_ripe": [
      0.012,
      0.05,
      0.5
    ],
